# 公式サーバー。通常は変更不要です。
KAKOMIMASU_HOST=https://api.kakomimasu.com

# free: 空いているフリー対戦へ参加
# game: GAME_ID の対戦へ参加
# ai: 公式サンプルAIとの対戦（AI_NAME と AI_BOARD を指定）
MATCH_MODE=free

# ゲスト参加時に表示される AI（エージェント）の名前・紹介文
AGENT_NAME=My Kakomimasu AI
PLAYER_SPEC=囲みコード

# ビューアのマイページで取得したトークンを入れると自分のアカウントで参加します。
# 未設定ならゲスト参加です。
# BEARER_TOKEN=

# MATCH_MODE=game のときだけ設定
# GAME_ID=

# MATCH_MODE=ai のときだけ設定（例: a1, a2, a3, a4, none）
# AI_NAME=none
# AI_BOARD=A-1
